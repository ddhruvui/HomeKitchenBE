{
  "name": "@home-kitchen/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "tsc -p ../shared/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/api/src/server.js",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:gemini": "tsx scripts/gemini-smoke.ts",
