MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0
DB_PASSWORD=
DB_NAME=HomeKitchen
TEST_DB_NAME=HomeKitchenTest
USE_TEST_DB=true
GEMINI_API_KEY=
# A stable Flash model. Thinking is turned down to MINIMAL in code (src/gemini.ts) — leaving it on costs ~60k thought
# tokens and three minutes per prompt. Override GEMINI_THINKING with an empty value if a model refuses the setting.
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when GEMINI_MODEL is overloaded (503) or out of quota (429). The free tier allows 20 requests a day
# PER MODEL, so a fallback is a fresh allowance, not a second go at a spent one. These defaults are Google's moving
# aliases, which cannot go stale the way a pinned id can — the 2.x line is already retired. Set to "none" to disable.
GEMINI_FALLBACK_MODEL=gemini-flash-latest,gemini-flash-lite-latest
PORT=3000
CRON_SECRET=
