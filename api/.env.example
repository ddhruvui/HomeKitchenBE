MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0
DB_PASSWORD=
DB_NAME=HomeKitchen
TEST_DB_NAME=HomeKitchenTest
USE_TEST_DB=true
GEMINI_API_KEY=
# A stable Flash model. Thinking is turned down to MINIMAL in code (src/gemini.ts) — leaving it on costs ~60k thought
# tokens and three minutes per recipe draft. Override GEMINI_THINKING with an empty value if a model refuses the setting.
GEMINI_MODEL=gemini-3.5-flash
PORT=3000
CRON_SECRET=
